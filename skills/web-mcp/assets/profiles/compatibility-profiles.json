      "requires": ["at-least-one-webmcp-profile", "real-application-operation", "visible-or-durable-effect-evidence"]
    },
    {
      "id": "DUAL",
      "definition": "A genuine WebMCP surface plus an independently useful MCP adapter over the same domain or backend contract.",
      "requires": ["at-least-one-webmcp-profile", "mcp-architecture", "surface-separation", "independent-tests", "host-composition-test"],

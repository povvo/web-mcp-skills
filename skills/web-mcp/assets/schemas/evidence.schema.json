{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:webmcp-site-tools:schema:evidence:v1",
  "title": "WebMCP executed evidence report",
  "description": "Machine-readable receipts for an identified WebMCP candidate. Planned or unavailable checks cannot be represented as passes.",
  "type": "object",
  "required": ["schemaVersion", "candidate", "profile", "gates", "summary"],
  "properties": {
    "$schema": {"type": "string", "minLength": 1},
    "schemaVersion": {"const": "webmcp-evidence.v1"},
    "candidate": {
      "type": "object",
      "required": [
        "productSha256", "toolsetSha256", "repositoryRevision", "dirty", "generatedAt"
      ],
      "properties": {
        "productSha256": {"$ref": "#/$defs/sha256"},
        "toolsetSha256": {"$ref": "#/$defs/sha256"},
        "repositoryRevision": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "dirty": {"type": "boolean"},
        "generatedAt": {"type": "string", "format": "date-time"}
      },
      "additionalProperties": false
    },
    "profile": {
      "type": "object",
      "required": ["release", "targets"],
      "properties": {
        "release": {"enum": ["development", "production", "challenge"]},
        "targets": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["webmcp-document", "chatgpt-site-tools", "chromium-webmcp", "mcp", "service-worker-proposal"]
          }
        }
      },
      "additionalProperties": false
    },
    "gates": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/gate"}
    },
    "summary": {
      "type": "object",
      "required": ["status", "counts"],
      "properties": {
        "status": {"$ref": "#/$defs/status"},
        "counts": {
          "type": "object",
          "required": ["PASS", "FAIL", "BLOCKED", "UNSUPPORTED", "NOT_RUN"],
          "properties": {
            "PASS": {"type": "integer", "minimum": 0},
            "FAIL": {"type": "integer", "minimum": 0},
            "BLOCKED": {"type": "integer", "minimum": 0},
            "UNSUPPORTED": {"type": "integer", "minimum": 0},
            "NOT_RUN": {"type": "integer", "minimum": 0}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "status": {"enum": ["PASS", "FAIL", "BLOCKED", "UNSUPPORTED", "NOT_RUN"]},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "evidenceItem": {
      "type": "object",
      "required": ["kind", "value"],
      "properties": {
        "kind": {"enum": ["file", "command", "url", "screenshot", "log", "receipt", "note"]},
        "value": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "gate": {
      "type": "object",
      "required": ["id", "status", "required", "evidence"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "pattern": "^[a-z0-9][a-z0-9._-]*$"},
        "status": {"$ref": "#/$defs/status"},
        "required": {"type": "boolean"},
        "command": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "workingDirectory": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "startedAt": {"type": "string", "format": "date-time"},
        "endedAt": {"type": "string", "format": "date-time"},
        "durationMs": {"type": "integer", "minimum": 0},
        "exitCode": {"type": ["integer", "null"]},
        "stdoutSha256": {"$ref": "#/$defs/sha256"},
        "stderrSha256": {"$ref": "#/$defs/sha256"},
        "reason": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "evidence": {
          "type": "array",
          "items": {"$ref": "#/$defs/evidenceItem"}
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:webmcp-site-tools:schema:verification-report:v1",
  "title": "Layered WebMCP verification report",
  "type": "object",
  "required": [
    "schemaVersion",
    "status",
    "candidate",
    "profile",
    "classes",
    "gates",
    "sourceStatus",
    "evidence",
    "evidenceContract",
    "decision"
  ],
  "properties": {
    "schemaVersion": {"const": "webmcp-verification-report.v1"},
    "status": {"$ref": "#/$defs/status"},
    "candidate": {"$ref": "#/$defs/candidate"},
    "profile": {"$ref": "#/$defs/profile"},
    "classes": {
      "type": "object",
      "propertyNames": {
        "enum": [
          "deterministic",
          "source",
          "wpt",
          "browser",
          "agent",
          "host-native",
          "dual",
          "deployment",
          "package",
          "challenge",
          "release"
        ]
      },
      "additionalProperties": {"$ref": "#/$defs/classSummary"}
    },
    "gates": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/gate"}
    },
    "sourceStatus": {
      "type": "object",
      "required": ["schemaVersion", "asOf", "release", "freshnessDays", "status", "counts", "sources"],
      "properties": {
        "schemaVersion": {"const": "webmcp-source-status.v1"},
        "asOf": {"type": "string", "format": "date-time"},
        "release": {"enum": ["development", "production", "challenge"]},
        "freshnessDays": {"type": "integer", "minimum": 0},
        "status": {"$ref": "#/$defs/status"},
        "counts": {"$ref": "#/$defs/counts"},
        "sources": {"type": "array", "items": {"type": "object"}}
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "required": ["schemaVersion", "candidate", "profile", "gates", "summary"]
    },
    "evidenceContract": {
      "type": "object",
      "required": ["status"]
    },
    "decision": {
      "type": "object",
      "required": ["releaseReady", "status", "exitCode", "blockingGateIds"],
      "properties": {
        "releaseReady": {"type": "boolean"},
        "status": {"$ref": "#/$defs/status"},
        "exitCode": {"enum": [0, 1, 2, 3, 4]},
        "blockingGateIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"}
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "status": {"enum": ["PASS", "FAIL", "BLOCKED", "UNSUPPORTED", "NOT_RUN"]},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "candidate": {
      "type": "object",
      "required": ["productSha256", "toolsetSha256", "repositoryRevision", "dirty", "generatedAt"],
      "properties": {
        "productSha256": {"$ref": "#/$defs/sha256"},
        "toolsetSha256": {"$ref": "#/$defs/sha256"},
        "repositoryRevision": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "dirty": {"type": "boolean"},
        "generatedAt": {"type": "string", "format": "date-time"}
      },
      "additionalProperties": false
    },
    "profile": {
      "type": "object",
      "required": ["release", "targets"],
      "properties": {
        "release": {"enum": ["development", "production", "challenge"]},
        "targets": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["webmcp-document", "chatgpt-site-tools", "chromium-webmcp", "mcp", "service-worker-proposal"]
          }
        }
      },
      "additionalProperties": false
    },
    "counts": {
      "type": "object",
      "required": ["PASS", "FAIL", "BLOCKED", "UNSUPPORTED", "NOT_RUN"],
      "properties": {
        "PASS": {"type": "integer", "minimum": 0},
        "FAIL": {"type": "integer", "minimum": 0},
        "BLOCKED": {"type": "integer", "minimum": 0},
        "UNSUPPORTED": {"type": "integer", "minimum": 0},
        "NOT_RUN": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "required": ["kind", "value"],
      "properties": {
        "kind": {"enum": ["file", "command", "url", "screenshot", "log", "receipt", "note"]},
        "value": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "gate": {
      "type": "object",
      "required": ["id", "evidenceClass", "status", "required", "automated", "evidence", "details"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
        "evidenceClass": {
          "enum": [
            "deterministic", "source", "wpt", "browser", "agent", "host-native",
            "dual", "deployment", "package", "challenge", "release"
          ]
        },
        "status": {"$ref": "#/$defs/status"},
        "required": {"type": "boolean"},
        "automated": {"type": "boolean"},
        "reason": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "command": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "workingDirectory": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "startedAt": {"type": "string", "format": "date-time"},
        "endedAt": {"type": "string", "format": "date-time"},
        "durationMs": {"type": "integer", "minimum": 0},
        "exitCode": {"type": ["integer", "null"]},
        "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
        "details": {"type": "object"}
      },
      "additionalProperties": false
    },
    "classSummary": {
      "type": "object",
      "required": ["status", "requiredStatus", "counts", "gateIds"],
      "properties": {
        "status": {"$ref": "#/$defs/status"},
        "requiredStatus": {"$ref": "#/$defs/status"},
        "counts": {"$ref": "#/$defs/counts"},
        "gateIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"}
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
